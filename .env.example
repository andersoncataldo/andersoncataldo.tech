# Google Gemini API (Opcional no dev: se ausente, usa o pipeline Híbrido Local)
GEMINI_API_KEY=

# Fallback cross-provider opcional (OpenAI ou endpoint OpenAI-compatível como Groq/OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Supabase PostgreSQL (Dual-Layer AI Telemetry, Answer Cache & Recruiter Leads)
# Projeto: andersoncataldo's Project (cagywhslrofuwlmpzbfy)
SUPABASE_URL=https://cagywhslrofuwlmpzbfy.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
AI_WRITE_SECRET=your-64-char-hex-write-secret

# Webhook opcional (Discord/Slack) para notificação imediata de novos leads
LEAD_WEBHOOK_URL=
